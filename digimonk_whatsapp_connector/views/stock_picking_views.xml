<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_whatsapp" model="ir.ui.view">
        <field name="name">stock.picking.form.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- WhatsApp stat button in button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_whatsapp_messages"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"
                        invisible="whatsapp_message_count == 0">
                    <field name="whatsapp_message_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>

            <!-- Send via WhatsApp button in header -->
            <xpath expr="//header/button[@name='button_validate']" position="after">
                <button name="action_send_whatsapp"
                        string="Send via WhatsApp"
                        type="object"
                        class="btn-success"
                        invisible="state not in ('assigned', 'done')"/>
            </xpath>

        </field>
    </record>
</odoo>
