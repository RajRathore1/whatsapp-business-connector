<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_whatsapp" model="ir.ui.view">
        <field name="name">sale.order.form.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- WhatsApp message count smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_whatsapp_messages"
                        icon="fa-comments"
                        invisible="whatsapp_message_count == 0">
                    <field string="WhatsApp" name="whatsapp_message_count" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Send via WhatsApp button next to Send by Email -->
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_send_whatsapp"
                        string="Send via WhatsApp"
                        type="object"
                        class="btn-success"
                        invisible="state not in ('draft', 'sent', 'sale')"/>
            </xpath>
        </field>
    </record>
</odoo>
